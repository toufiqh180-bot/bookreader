{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookReader",
  "version": "0.1.0",
  "identifier": "org.bookreader.app",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BookReader",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 17 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' data: blob: ws: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A free PDF reader made for reading books.",
    "longDescription": "BookReader reflows and paginates PDFs for comfortable reading, with highlights, notes, bookmarks, OCR and export. Free and open source.",
    "copyright": "Copyright © BookReader contributors. MIT licensed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "../build/background.png",
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 150, "y": 220 },
        "applicationFolderPosition": { "x": 390, "y": 220 }
      }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
