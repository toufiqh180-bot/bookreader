{
  "name": "bookreader",
  "productName": "BookReader",
  "version": "0.1.0",
  "description": "A free, open-source PDF reader designed for reading books: reflow, night modes, margin cropping, annotations, OCR and more.",
  "main": "src/main/index.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "author": "BookReader contributors",
  "homepage": "https://github.com/toufiqh180-bot/bookreader",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toufiqh180-bot/bookreader.git"
  },
  "bugs": {
    "url": "https://github.com/toufiqh180-bot/bookreader/issues"
  }
}
