{
  "name": "bookreader",
  "productName": "BookReader",
  "version": "0.1.0",
  "description": "A free, open-source PDF reader for books — desktop (macOS, Windows, Linux) and web/PWA.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "preview:web": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "vite build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "vite build && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "vite build && electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "vite build && electron-builder --config electron-builder.config.cjs --linux",
    "icons": "node scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.6.2",
    "radix-ui": "^1.7.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "author": "BookReader contributors",
  "homepage": "https://github.com/toufiqh180-bot/bookreader",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toufiqh180-bot/bookreader.git"
  },
  "bugs": {
    "url": "https://github.com/toufiqh180-bot/bookreader/issues"
  },
  "type": "module"
}
